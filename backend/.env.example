DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
TIME_ZONE=UTC
MAX_UPLOAD_MB=10

ROBOFLOW_API_KEY=
# For classification models: https://classify.roboflow.com
# If your account uses another Hosted API address (e.g. https://serverless.roboflow.com), change only this value.
ROBOFLOW_API_URL=https://detect.roboflow.com
ROBOFLOW_MODEL_ID=
ROBOFLOW_MODEL_VERSION=
# object-detection or classification
ROBOFLOW_MODEL_TYPE=object-detection
ROBOFLOW_TIMEOUT_SECONDS=15
# Model threshold: predictions below it are dropped
ROBOFLOW_MIN_CONFIDENCE=0.40
# Below this value the result gets the low_confidence status
LOW_CONFIDENCE_THRESHOLD=0.60

# Recognition rate limit per device (DRF throttle format)
RECOGNIZE_RATE=30/min
# Login / registration attempts per IP
AUTH_RATE=10/min
